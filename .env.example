DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/ecolima
SECRET_KEY=change-this-to-a-32-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_MODELS=ecolima-models
# Opcional -- default "datasets" si no se setea (nombre real del contenedor en Azure)
AZURE_BLOB_CONTAINER_DATASETS=datasets
# Opcional -- orígenes CORS separados por coma, sin barra final. Si no se
# setea (o queda vacía), se usa DEFAULT_CORS_ORIGINS en config.py.
CORS_ALLOWED_ORIGINS=https://mango-cliff-03aa6110f.7.azurestaticapps.net,http://localhost:5173
# Envío de correo (recuperar contraseña e invitaciones de alta en bloque).
# Las 4 deben estar presentes juntas -- si falta una, SMTP se trata como no
# configurado (ver _smtp_config en password_reset_service.py).
# Al cambiar de cuenta de Gmail (ej. de una personal/de pruebas a la cuenta
# oficial de EcoLima), solo cambian SMTP_USER y SMTP_PASS -- SMTP_HOST y
# SMTP_PORT quedan igual salvo que se prefiera el puerto 465 (SSL directo)
# en vez de 587 (STARTTLS); el código soporta ambos según SMTP_PORT.
# SMTP_PASS es la contraseña de aplicación de 16 caracteres (Contraseñas de
# aplicaciones en la cuenta de Google, requiere verificación en dos pasos),
# no la contraseña normal de la cuenta -- se puede pegar tal como Google la
# muestra, en 4 grupos separados por espacio: el backend los quita solo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ecolima@gmail.com
SMTP_PASS=your-email-app-password
ADMIN_EMAIL=admin@ecolima.pe
ADMIN_PASSWORD=change-this-to-a-strong-generated-password
# Usada también por scripts/create_analista.py (cuenta de prueba local)
ANALISTA_PASSWORD=change-this-to-a-strong-generated-password
# Obligatoria -- dominio del frontend (sin barra final), para construir el
# enlace de POST /auth/forgot-password: {FRONTEND_BASE_URL}/restablecer?token=...
FRONTEND_BASE_URL=http://localhost:5173
ML_INFERENCE_THRESHOLD=0.5
ML_PRIORITY_HIGH=0.7
ML_PRIORITY_MEDIUM=0.4
ML_API_URL=http://4.248.185.133
ML_API_TIMEOUT_SECONDS=15
